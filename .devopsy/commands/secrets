#!/bin/sh
## Description: Generate the secrets missing from .env (run on the server by release)
# The release's prepare step (config.yaml): it runs in the new release
# before it goes live, so devopsy's check of the variables compose requires
# finds them, on a server and locally (devopsy --release). It only adds
# what is missing, never changes a secret: a new database password would no longer
# match the database.
set -eu

env_file="$DEVOPSY_PROJECT_DIR/.env"

# secret NAME: append a random value to .env unless NAME is already set,
# in .env or anywhere devopsy loads from: a child inherits prod's
# DB_PASSWORD (shared/inherit.env) and must not get one of its own.
secret() {
  if [ -z "$(eval "printf '%s' \"\${$1:-}\"")" ]; then
    # Keep the new line separate when .env does not end with a newline.
    if [ -s "$env_file" ] && [ "$(tail -c 1 "$env_file")" != "" ]; then
      echo >> "$env_file"
    fi
    echo "$1=$(head -c 48 /dev/urandom | base64 | tr -d '\n' | tr '+/' '-_')" >> "$env_file"
    echo "secrets: generated $1 in .env" >&2
  fi
}
secret DB_PASSWORD
secret DRUPAL_HASH_SALT
