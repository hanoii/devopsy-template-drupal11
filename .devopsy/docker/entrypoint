#!/bin/sh
# Container entrypoint.
#
# Starts as root to prepare the storage and logs mounts, then drops
# privileges to the app user with setpriv. On servers the mount is created by
# devopsy's deploy user, so the first start chowns it; the recursive chown runs
# only when the content does not belong to the app user yet.
#
# When not started as root (docker run --user, etc.) it only runs the command.
set -eu

STORAGE_DIR="${STORAGE_DIR:-/app/storage}"

# HTTP basic auth (see docker/Caddyfile): SITE_BASIC_AUTH=user:password.
# Caddy only takes a bcrypt hash: hash it here and drop the plaintext before
# PHP starts.
if [ "${1:-}" = frankenphp ] && [ -n "${SITE_BASIC_AUTH:-}" ]; then
  case $SITE_BASIC_AUTH in
    ?*:?*) ;;
    *)
      echo "entrypoint: SITE_BASIC_AUTH must be user:password" >&2
      exit 1
      ;;
  esac
  SITE_BASIC_AUTH_USER=${SITE_BASIC_AUTH%%:*}
  SITE_BASIC_AUTH_HASH=$(frankenphp hash-password --plaintext "${SITE_BASIC_AUTH#*:}")
  export SITE_BASIC_AUTH_USER SITE_BASIC_AUTH_HASH
  unset SITE_BASIC_AUTH
  echo "entrypoint: basic auth enabled for $SITE_BASIC_AUTH_USER" >&2
fi

if [ "$(id -u)" != "0" ]; then
  exec "$@"
fi

app_uid="$(id -u app)"
if [ -d "$STORAGE_DIR/public" ] && [ "$(stat -c %u "$STORAGE_DIR/public")" != "$app_uid" ]; then
  echo "entrypoint: chown -R app $STORAGE_DIR" >&2
  chown -R app:app "$STORAGE_DIR"
fi

# Create (or fix the owner of) the mount point and its subdirectories.
install -d -o app -g app "$STORAGE_DIR" "$STORAGE_DIR/public" "$STORAGE_DIR/private"

# The access log's mount (docker/Caddyfile): docker creates it as root.
if [ -d /app/logs ]; then
  chown app:app /app/logs
fi

exec setpriv --reuid=app --regid=app --init-groups env HOME=/tmp "$@"
