# Settings for .devopsy/.env (gitignored), on servers shared/.env, set with
# devopsy @<target> --vars set KEY. All optional.

# Generated by `devopsy secrets` (a release's prepare step) when missing.
# Never change them on a site with data: the database keeps its password.
#DB_PASSWORD=
#DRUPAL_HASH_SALT=

# HTTP basic auth for the whole site, user:password. Children (dev, pr-*)
# inherit prod's on their first release and every clone.
#SITE_BASIC_AUTH=

# What the app's healthcheck requests: a static file, so only Caddy answers.
#HEALTHCHECK_PATH=/robots.txt

# How clones copy the database, set on prod (children inherit it):
#   skip  the default: a dump (mariadb-dump --single-transaction) from the
#         running parent into the child's running database. Prod stays up;
#         the child keeps its own DB_PASSWORD.
#   stop  the raw datadir, rsynced with the database stopped on both sides:
#         prod's database is down for the copy, and its app paused. The
#         datadir carries prod's users and passwords, so the child needs
#         prod's DB_PASSWORD: add it to prod's inherit: in config.yaml.
#CLONE_DATABASE=skip
