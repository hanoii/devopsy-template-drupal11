#!/bin/sh
# The data capability's import (devopsy-cli's README, "Capabilities"):
# reads one service's data from stdin, as export writes it, and replaces
# what the service had. devopsy runs it on the child, in its current
# release with its environment, for each service copied as
# devopsy.data.copy=custom when it is synced from its parent, and for
# --import:
#   devopsy --import database < dump.sql
# devopsy only runs it once the whole stream arrived (export exited 0)
# and has the service up first: nothing here checks or starts either.
# Only the database is this script's (DATA_DATABASE=custom, compose.yaml),
# loaded into the running database, which needs devopsy.data.stop=never;
# devopsy stops the app (its import label) meanwhile, and keeps it down
# if the load fails.
set -eu
service=${1:?usage: import <service>}

case " ${DEVOPSY_DATA_STOP:-} " in
  *" $service "*)
    echo "import: $service is stopped for the copy, and loading a dump needs the database running: devopsy.data.stop=never for a dump (DATA_DATABASE_STOP=never)" >&2
    exit 1
    ;;
esac

case $service in
  database)
    # The child's database starts empty: dropped and created again, then
    # loaded. Its credentials from its own container's environment (on a
    # child DB_PASSWORD is prod's, inherited).
    # shellcheck disable=SC2016
    devopsy exec -T database sh -c '
      set -eu
      mariadb -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" \
        -e "DROP DATABASE IF EXISTS $MARIADB_DATABASE; CREATE DATABASE $MARIADB_DATABASE"
      mariadb -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE"
      echo "import: database imported" >&2
    '
    ;;
  *)
    echo "import: no import for $service, only database" >&2
    exit 1
    ;;
esac
