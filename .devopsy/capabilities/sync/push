#!/bin/sh
# The sync capability's push (devopsy-cli's README, "Capabilities"): devopsy
# runs it on the parent (prod), in its current release with its environment,
# when a child is syncd (its first release, or devopsy @<child> --sync).
# The child is ready: its app paused (its own devopsy.sync labels,
# compose.yaml). Its database may not exist yet: on a child's first
# release nothing of it has run, so this starts it. Afterwards the child's
# deploy runs on the copy: database updates, config import, caches.
#
# Only the database is this script's, and only with SYNC_DATABASE=custom
# on prod (compose.yaml labels it devopsy.sync=custom then; the default,
# stop, lets devopsy rsync the datadir instead and never runs this).
# devopsy has already rsynced storage and logs, the app's mounts, with the
# app paused on both sides. Arguments given to --sync after -- are
# rsync's, not used here.
set -eu

# The child's database, started when it is not running yet (a first
# release); its DB_PASSWORD is already there, inherited from prod before
# the release's prepare.
devopsy --sync-exec up -d --wait database </dev/null

# The dump: prod keeps running, consistent through one transaction. Each
# side's credentials from its own database container's environment, read
# inside it: no password on a command line here.
#
# A POSIX pipeline only reports its last command, so a failed or cut dump
# is caught on the child: it keeps the dump in its container's /tmp and
# only imports it when it ends with mariadb-dump's last line, "-- Dump
# completed". Until then the child's database is untouched. That costs the
# child the dump's size on disk for a moment, and keeps the parent's disk
# and the transport out of it.
# shellcheck disable=SC2016
devopsy exec -T database sh -c '
  exec mariadb-dump -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" \
    --single-transaction --quick --routines --events "$MARIADB_DATABASE"
' </dev/null | devopsy --sync-exec exec -T database sh -c '
  set -eu
  dump=$(mktemp)
  trap "rm -f \"$dump\"" EXIT
  cat >"$dump"
  case $(tail -n 1 "$dump") in
    "-- Dump completed"*) ;;
    *)
      echo "sync: the dump from the parent is incomplete; the database is left as it was" >&2
      exit 1
      ;;
  esac
  mariadb -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" \
    -e "DROP DATABASE IF EXISTS $MARIADB_DATABASE; CREATE DATABASE $MARIADB_DATABASE"
  mariadb -u"$MARIADB_USER" -p"$MARIADB_PASSWORD" "$MARIADB_DATABASE" <"$dump"
  echo "sync: database imported" >&2
'
