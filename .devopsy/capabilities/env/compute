#!/bin/sh
# The env capability (devopsy-cli's README, "Capabilities"): devopsy runs it
# before every command and sets what it prints, unless already set. This
# site's hosts, from its compose project name (COMPOSE_PROJECT_NAME, always
# set by devopsy), the base domain imported from the server's proxy
# (compose.yaml's devopsy.import label) and the environment's
# PROXY_DOMAINS (space or comma separated):
#   SITE_HOST_RULE  a Traefik rule for every host, for the router's labels
#   SITE_URL        https://<the first: the custom domain, else the wildcard>
# Locally, without a base domain, the wildcard host is
# <name>.localhost; in a release without one (DEVOPSY_TARGET is set) there
# is none, and a release without PROXY_DOMAINS has no host at all.
set -euf
# Data (compose.yaml's devopsy.data labels): a raw datadir (DATA_DATABASE
# unset or volumes): nothing printed, the database is stopped while its
# data moves (own), and the app with it. A dump (custom): the database keeps
# running (never: the dump and the load need it), the app is down only
# while data is imported (its import label). devopsy only sets what is
# unset: set DATA_DATABASE_STOP yourself to choose otherwise.
if [ "${DATA_DATABASE:-volumes}" = custom ]; then
  echo "DATA_DATABASE_STOP='never'"
fi
name=${COMPOSE_PROJECT_NAME:?}
# Names from before are refused when set at all (empty was the wildcard's
# opt-out), naming their new one: nothing reads them, so a custom domain,
# a resolver or the opt-out would go without a word. PROXY_CERTRESOLVER
# names one of the Traefik template's resolvers, the old names refused
# with their new one: a router naming a resolver the server's Traefik
# lacks gets no certificate, which Traefik only logs.
renamed() {
  echo "$1 is $2 now: rename it" >&2
  exit 1
}
[ -z "${DEVOPSY_DOMAINS+x}" ] || renamed DEVOPSY_DOMAINS PROXY_DOMAINS
[ -z "${CERTRESOLVER+x}" ] || renamed CERTRESOLVER PROXY_CERTRESOLVER
[ -z "${DEVOPSY_WILDCARD_DOMAIN+x}" ] || renamed DEVOPSY_WILDCARD_DOMAIN PROXY_BASE_DOMAIN
case ${PROXY_CERTRESOLVER:-} in
  letsencrypt1) renamed "PROXY_CERTRESOLVER's letsencrypt1" le-http01 ;;
  acmedns) renamed "PROXY_CERTRESOLVER's acmedns" le-dns01-selfhosted ;;
  cloudflare) renamed "PROXY_CERTRESOLVER's cloudflare" le-dns01-cloudflare ;;
  '' | le-http01 | le-dns01-selfhosted | le-dns01-cloudflare) ;;
  *)
    echo "PROXY_CERTRESOLVER must be le-http01, le-dns01-selfhosted or le-dns01-cloudflare: $PROXY_CERTRESOLVER" >&2
    exit 1
    ;;
esac
# Checked alone: in the hosts below, a space or a comma would make it two.
case ${PROXY_BASE_DOMAIN:-} in
  *[!A-Za-z0-9.-]* | .* | *. | *..*)
    echo "PROXY_BASE_DOMAIN is not a domain name: $PROXY_BASE_DOMAIN" >&2
    exit 1
    ;;
esac
wildcard=
if [ -n "${PROXY_BASE_DOMAIN:-}" ]; then
  wildcard=$name.$PROXY_BASE_DOMAIN
elif [ -z "${DEVOPSY_TARGET:-}" ]; then
  wildcard=$name.localhost
fi
wildcard_host=$(printf '%s' "$wildcard" | tr '[:upper:]' '[:lower:]')
hosts=
for h in $(printf '%s %s' "${PROXY_DOMAINS:-}" "$wildcard" | tr ',A-Z' ' a-z'); do
  case $h in
    *\**)
      # Traefik's Host() matches a name literally: it would never match.
      echo "PROXY_DOMAINS: $h is a wildcard: name each host" >&2
      exit 1
      ;;
    *[!a-z0-9.-]* | .* | *. | *..*)
      if [ "$h" = "$wildcard_host" ]; then
        echo "the wildcard host, $h, is not a hostname (from the environment's name)" >&2
      else
        echo "PROXY_DOMAINS: $h is not a hostname" >&2
      fi
      exit 1
      ;;
  esac
  case " $hosts " in
    *" $h "*) ;;
    *) hosts=${hosts:+$hosts }$h ;;
  esac
done
[ -n "$hosts" ] || exit 0
rule=
for h in $hosts; do
  rule="${rule:+$rule || }Host(\`$h\`)"
done
echo "SITE_HOST_RULE='$rule'"
echo "SITE_URL='https://${hosts%% *}'"
