# Settings for .devopsy/.env (gitignored), on servers shared/.env, set with
# devopsy @<target> --vars set KEY. All optional.

# Generated by `devopsy secrets` (a release's prepare step) when missing.
# Never change them on a site with data: the database keeps its password.
#DB_PASSWORD=
#DRUPAL_HASH_SALT=

# HTTP basic auth for the whole site, user:password. Children (dev, pr-*)
# inherit prod's on their first release and every sync.
#SITE_BASIC_AUTH=

# What the app's healthcheck requests: a static file, so only Caddy answers.
#HEALTHCHECK_PATH=/robots.txt

# How the database's data moves (syncs, --export, --import), set on prod
# (children inherit it):
#   mnt     the default: the raw datadir, with the database and the app
#           stopped while it moves (on both sides of a sync). prod is
#           down for the copy; the child uses prod's DB_PASSWORD
#           (inherited).
#   stream  a dump (mariadb-dump --single-transaction) of the running
#           database, loaded into the other side's, by
#           capabilities/data/export and import. prod stays up; the
#           importing side's app is down for the load.
#   none    the database is left out of every copy.
#DATA_DATABASE=mnt

# How long alwaysup waits for the app before showing the maintenance page
# (a sync, a deploy, a failing start). Under a CDN's own limit, like
# Cloudflare's 100 seconds.
#ALWAYSUP_WAIT=60s

# When devopsy stops the database while data moves (devopsy.data.stop):
# own by default (while its own data moves, the app with it); never with
# DATA_DATABASE=stream (capabilities/env/compute), unless set here.
#DATA_DATABASE_STOP=own
