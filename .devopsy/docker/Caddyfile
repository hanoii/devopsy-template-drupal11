# Caddyfile for Drupal on FrankenPHP.
# https://frankenphp.dev/docs/config
# https://caddyserver.com/docs/caddyfile
{
	skip_install_trust
	# TLS is terminated by devopsy-template-traefik.
	auto_https off
	admin off
	persist_config off

	servers {
		# Traefik comes in over a Docker network: trust X-Forwarded-* for
		# client_ip and logs.
		trusted_proxies static private_ranges
	}

	# The access log (the site's log, below) also goes to the logs mount
	# (compose.yaml), where it outlives containers and releases, for `devopsy goaccess`.
	# Caddy rotates the file at 100MiB, compresses the old ones and keeps 10
	# of them, 90 days at most. Here, not as a second log in the site: a
	# site without host names only logs to one.
	log access_file {
		output file /app/logs/access.log {
			roll_keep_for 2160h
		}
		format json
		include http.log.access
	}

	frankenphp {
		# PHP's functions that run a program, disabled for web requests:
		# uncomment to block the shell behind most exploit chains and
		# webshells (code running as the app could still do anything PHP
		# itself can). It breaks what shells out during a request, like
		# ImageMagick's toolkit through exec, or a module running git or
		# a converter: try the site's uploads and image styles after
		# turning it on. Here, not in php.ini: FrankenPHP's php_ini
		# applies to the web server only, while php.ini also reaches
		# drush, which needs proc_open.
		# php_ini disable_functions exec,shell_exec,system,passthru,proc_open,popen
	}
}

:8080 {
	root * /app/web
	encode zstd br gzip

	# The access log, as JSON (duration is the whole request; for PHP
	# requests, PHP's time), to the container's output, for `devopsy logs`;
	# the global options above also write it to a file. The container's
	# healthcheck, every few seconds, stays out of both: HEALTHCHECK_PATH is
	# compose.yaml's, which requests it.
	log {
		output stdout
		format json
	}
	@healthcheck {
		path {$HEALTHCHECK_PATH:/robots.txt}
		remote_ip 127.0.0.1 ::1
	}
	log_skip @healthcheck

	# HTTP basic auth, only when SITE_BASIC_AUTH (user:password) is set:
	# docker/entrypoint hashes it into SITE_BASIC_AUTH_USER and
	# SITE_BASIC_AUTH_HASH. The default hash (of a random, discarded
	# password) only keeps this file valid when it is unset; the matcher is
	# false then. Requests from inside the container (the healthcheck) skip
	# it: remote_ip, not client_ip, so a forged X-Forwarded-For cannot match.
	@basic_auth {
		expression `{env.SITE_BASIC_AUTH_HASH} != ""`
		not remote_ip 127.0.0.1 ::1
	}
	basic_auth @basic_auth {
		{$SITE_BASIC_AUTH_USER:admin} {$SITE_BASIC_AUTH_HASH:$2a$10$kMUNBF5FnoGFGaDNESttce7OOf9mPSS/6Bh34E.DC47g3Yh9gpeNe}
	}

	# What is refused or served, in this order: a route keeps it, where
	# Caddy would sort respond after route. PHP is php_server written out,
	# as FrankenPHP 1.13 expands it (`frankenphp adapt`), with one step of
	# ours between its rewrite and its php handler: there the path is the
	# script PHP would run, however the request wrote it, with path info
	# (evil.php/x, evil.php%2Fx), in any case (PHP splits at .php ignoring
	# it), with dot segments or doubled slashes, or as a directory whose
	# index.php the rewrite picks (no .php in the request at all). A regex
	# on the request path missed some of those.
	route {
		# Same as Drupal's .htaccess rules: no hidden paths at any level, except .well-known.
		@dotfiles {
			path_regexp /\.
			not path /.well-known/*
		}
		respond @dotfiles 403

		# Code, config and backup files that must never be served.
		@sensitive path_regexp \.(engine|inc|install|make|module|profile|po|sh|.*sql|theme|twig|tpl(\.php)?|xtmpl|yml)(~|\.sw[op]|\.bak|\.orig|\.save)?$|^/(Entries.*|Repository|Root|Tag|Template|composer\.(json|lock)|web\.config)$|^/#.*#$|\.php(~|\.sw[op]|\.bak|\.orig|\.save)$
		respond @sensitive 403

		# A directory with an index.php gets its trailing slash.
		@canonicalPath {
			file {path}/index.php
			not path */
		}
		redir @canonicalPath {http.request.orig_uri.path}/ 308

		# The file asked for (up to its .php, the rest is path info), a
		# directory's index.php, else Drupal's index.php.
		@indexFiles file {
			try_files {path} {path}/index.php index.php
			try_policy first_exist_fallback
			split_path .php
		}
		rewrite @indexFiles {file_match.relative}{file_match.remainder}

		# Never run PHP from sites/: uploaded files (sites/default/files is
		# the storage mount, the only place the app can write under the web
		# root) and settings.php. Not anchored at the end and ignoring case,
		# as PHP's split. A missing file was rewritten to index.php above,
		# so image style derivatives still reach Drupal.
		@sites_php path_regexp (?i)^/sites/.*\.ph(p|ar|tml)
		respond @sites_php 403

		@phpFiles path *.php *.php/*
		php @phpFiles
		file_server
	}
}
