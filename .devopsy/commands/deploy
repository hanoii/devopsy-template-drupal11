#!/bin/sh
## Description: Build, start and update the site (run on the server by release)
# The environments' release and rollback run step (config.yaml), run on the
# server by `devopsy @<target> --release` and `--rollback`; or locally.
#
# It generates missing secrets first (secrets). It never installs the site:
# browse to it for Drupal's installer, or run `devopsy drush site:install`.
# Once installed, later runs apply updates: `drush deploy` when config/sync
# has exported configuration, otherwise database updates only.
set -eu

# Secrets first, as the release's prepare step already did: for local use.
devopsy secrets

devopsy build --pull
devopsy up -d --wait --remove-orphans

if ! devopsy exec -T app drush status --field=bootstrap 2>/dev/null | grep -q Successful; then
  echo "deploy: Drupal is not installed: browse to the site or run drush site:install" >&2
elif ls "$DEVOPSY_PROJECT_DIR"/../config/sync/*.yml >/dev/null 2>&1; then
  devopsy exec -T app drush deploy --yes
else
  # Nothing to import yet: config:import refuses an empty directory.
  devopsy exec -T app drush updatedb --yes
fi
echo "deploy: ${SITE_URL:-no URL: no wildcard domain or DEVOPSY_DOMAINS}" >&2
