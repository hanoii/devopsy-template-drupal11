#!/bin/sh
## Description: The site's access log in GoAccess: its terminal view, or a report (devopsy goaccess > report.html)
# Caddy's access log files (JSON, docker/Caddyfile) in mnt/logs, the
# rotated ones included, through GoAccess in its own container (the goaccess
# service): the files are the app user's, which the deploy user cannot read.
# It runs where the site does:
#   devopsy @prod goaccess                      GoAccess's terminal view (q quits)
#   devopsy @prod goaccess > report.html        an HTML report, on stdout
#   devopsy @prod goaccess -o json > report.json
# Arguments go to GoAccess. Without -o: the terminal view on a terminal,
# HTML otherwise.
set -eu

output=
for arg in "$@"; do
  case $arg in
    -o* | --output*) output=1 ;;
  esac
done
# The terminal view needs a terminal in the container; GoAccess reads its
# keys from it, since the log comes in on stdin.
tty=-T
if [ -z "$output" ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    tty=
  else
    set -- "$@" -o html
  fi
fi

# Oldest first: the rotated files (compressed once Caddy gets to them), then
# the current one.
# shellcheck disable=SC2016,SC2086
exec devopsy run --rm --no-deps $tty --entrypoint sh goaccess -c '
  for f in /logs/access-*.log.gz /logs/access-*.log /logs/access.log; do
    [ -f "$f" ] || continue
    case $f in
      *.gz) zcat "$f" ;;
      *) cat "$f" ;;
    esac
  done | goaccess - --log-format=CADDY --no-progress "$@"
' sh "$@"
