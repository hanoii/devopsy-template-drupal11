#!/bin/sh
# The status capability (devopsy-cli's README, "Capabilities"): what
# `devopsy --status` adds after the containers, with the project's
# environment loaded. One fact per line.
set -eu

echo "url          ${SITE_URL:-no URL: no wildcard domain or DEVOPSY_DOMAINS}"
# The login in front of the site, in full: this is where to look it up.
if [ -n "${SITE_BASIC_AUTH:-}" ]; then
  echo "basic auth   $SITE_BASIC_AUTH"
else
  echo "basic auth   none, the site is open"
fi
if [ -f "$DEVOPSY_PROJECT_DIR/mnt/maintenance/on" ]; then
  echo "maintenance  on (devopsy maintenance off brings the site back)"
else
  echo "maintenance  off"
fi
# When the app runs: the PHP it runs (FrankenPHP's own, which serves the
# site; an advisory's fix arrives with the next release, which builds on
# the base image's current tag), then Drupal's version and whether it is
# installed.
if devopsy ps --services --status running 2>/dev/null | grep -qx app; then
  # "FrankenPHP v1.13.0 PHP 8.4.27 Caddy v2.11.7 h1:...".
  php=$(devopsy exec -T app frankenphp version </dev/null 2>/dev/null |
    sed -n 's/^FrankenPHP v\([^ ]*\) PHP \([^ ]*\) .*/\2 (FrankenPHP \1)/p' || true)
  if [ -n "$php" ]; then
    echo "php          $php"
  fi
  version=$(devopsy exec -T app drush status --field=drupal-version </dev/null 2>/dev/null || true)
  if [ -n "$version" ]; then
    if devopsy exec -T app drush status --field=bootstrap </dev/null 2>/dev/null | grep -q Successful; then
      echo "drupal       $version, installed"
    else
      echo "drupal       $version, not installed (drush site:install)"
    fi
  fi
fi
